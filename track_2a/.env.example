# Copy to .env and fill in. .env is git-ignored.
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=your-cscs-api-key

# Eval only (src/eval/judge.py): judge model for the benches, e.g. the Apertus 70B id on the CSCS API.
# JUDGE_BASE_URL and JUDGE_API_KEY default to the LLM_* values. The coach itself never uses this.
JUDGE_NAME=

# Voice (optional). Whisper (speech-to-text) and Piper (text-to-speech) run in the backend on the CPU;
# their models (about 2.5 GB) are downloaded into data/models on the first start.
# STT_ENABLED=false
# STT_MODEL=small                   # faster but weaker model for fr/it (default large-v3-turbo)
# TTS_ENGINE=azure                  # Swiss Azure voices instead of Piper (piper | azure | off)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=switzerlandnorth
